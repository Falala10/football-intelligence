# Server-only. Copy to .env.local and add your key there; never commit it.
GEMINI_API_KEY=
# Use a Gemini text model with structured outputs. Free-tier availability/quotas depend on your Google project.
GEMINI_MODEL=gemini-3.5-flash-lite
# Auto uses Tavily when configured, then Google Search, then public lookups. Use tavily to require search/article retrieval.
FOOTBALL_RESEARCH_PROVIDER=auto
# Set provider to google only with eligible Google Search access. Search-capable model. Quotas/billing depend on the Google project.
GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite
FOTMOB_MCP_URL=http://127.0.0.1:8000/mcp
APP_TIMEZONE=America/New_York
# Optional, server-only The Odds API key. Never put a real key in this template.
ODDS_API_KEY=

# Optional server-only Tavily search/article key. Add the real value only to .env.local.
TAVILY_API_KEY=
